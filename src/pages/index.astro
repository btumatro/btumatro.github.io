---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import StatGrid from '../components/StatGrid.astro';
import TeamCard from '../components/TeamCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import CtaBand from '../components/CtaBand.astro';
import BasvuruButonlari from '../components/BasvuruButonlari.astro';
import home from '../data/home.json';
import achievements from '../data/achievements.json';
import sponsors from '../data/sponsors.json';
import { url, media, achievementSummary, degreeTone, publishedNews, teamIndex, teamHref } from '../lib/utils';

const allTeams = (await getCollection('teams')).sort((a, b) => a.data.order - b.data.order);
const teams = allTeams.filter(t => t.data.status !== 'Arşiv').slice(0, 6);
const takimDizini = teamIndex(allTeams);
const featured = achievements.items.filter(a => a.featured).slice(0, 6);
const achievementStats = achievementSummary(achievements.items);
const homeStats = home.stats.map((stat, index) => {
  if (index === 0) return { ...stat, value: achievementStats.records, label: 'Kayıtlı Derece' };
  if (index === 1) return { ...stat, value: achievementStats.firstPlaces, label: 'Birincilik' };
  if (index === 4) return { ...stat, value: achievementStats.finalists2026 };
  return stat;
});
const news = publishedNews(await getCollection('haberler'));
const announcements = news.filter(item => item.data.pinned).slice(0, 2);
const latestNews = news.slice(0, 3);
const dateFmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const heroImage = media(home.hero.backgroundImage);
const platinSponsors = sponsors.current.filter((s) => s.package === 'Platin');
const altinSponsors = sponsors.current.filter((s) => s.package === 'Altın');
const gumusSponsors = sponsors.current.filter((s) => s.package === 'Gümüş');
const bronzSponsors = sponsors.current.filter((s) => s.package === 'Bronz');
---

<BaseLayout>
  <section class="home-hero container-matro">
    <div class="hero-topline">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <a href={url('/hakkimizda')} class="hero-about">Topluluğu tanı <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-heading">
      <h1>{home.hero.title}</h1>
      <div class="hero-intro">
        <p>{home.hero.description}</p>
        <div class="hero-actions">
          <a href={url(home.hero.primaryCta.href)} class="button-primary">{home.hero.primaryCta.label}<span aria-hidden="true">↗</span></a>
          <a href={url(home.hero.secondaryCta.href)} class="text-link">{home.hero.secondaryCta.label}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    {heroImage && <figure class="hero-photo">
      <img src={heroImage} alt={home.hero.imageAlt} fetchpriority="high" decoding="async" width="1600" height="900" />
      <figcaption><span>{home.hero.imageCaption}</span><a href={url('/galeri')}>Fotoğraf arşivi <span aria-hidden="true">↗</span></a></figcaption>
    </figure>}
    <div class="hero-bottom"><p>Makine Teknolojileri Robot ve Otomasyon Topluluğu</p><a href={url(home.hero.tertiaryCta.href)}>{home.hero.tertiaryCta.label} <span aria-hidden="true">↗</span></a></div>
  </section>

  {announcements.length > 0 && <aside class="container-matro notice-strip" aria-label="Öne çıkan duyurular">
    <span class="eyebrow">Gündem</span>
    <div>{announcements.map(item => <a href={url(`/haberler#${item.id}`)}><span>{item.data.title}</span><span aria-hidden="true">↗</span></a>)}</div>
  </aside>}

  <Section eyebrow="Rakamlarla MATRO" title="Birlikte, yıllar içinde." class="home-stats">
    <div class="mt-9"><StatGrid stats={homeStats} /></div>
  </Section>

  <Section eyebrow="Proje takımları" title="Bir merak. Bir takım. Bir proje." description="Havada, karada ve suyun altında. Her takımda başka bir mühendislik problemi, aynı üretme tutkusu." class="home-teams" id="takimlar">
    <div class="section-action"><a class="text-link" href={url('/takimlarimiz')}>Tüm takımlar <span aria-hidden="true">↗</span></a></div>
    <div class="teams-grid">{teams.map((team, i) => <TeamCard slug={team.id} {...team.data} delay={(i % 3) * 50} />)}</div>
  </Section>

  <Section eyebrow="Atölyeden sahaya" title={home.video.title} description={home.video.description} class="home-film">
    <div class="mt-9"><VideoEmbed youtubeId={home.video.youtubeId} title={home.video.title} /></div>
  </Section>

  <Section eyebrow={home.highlights.eyebrow} title={home.highlights.title} description={home.highlights.description} class="home-achievements">
    <div class="achievement-list mt-10">
      {featured.map(a => <article class="achievement-row reveal">
        <span class="achievement-year">{a.year}</span>
        <div><h3>{a.competition}</h3><p>{a.category}</p></div>
        <div class="achievement-result"><strong class={degreeTone(a.degree)}>{a.degree}</strong>{a.team && (teamHref(takimDizini, a.team) ? <a href={teamHref(takimDizini, a.team)}>{a.team} ↗</a> : <span>{a.team}</span>)}</div>
      </article>)}
    </div>
    <a class="text-link mt-7" href={url('/basarilarimiz')}>Tüm dereceler ve ödüller <span aria-hidden="true">↗</span></a>
  </Section>

  {latestNews.length > 0 && <Section eyebrow="Haberler" title="MATRO’da neler oluyor?" class="home-news">
    <div class="section-action"><a class="text-link" href={url('/haberler')}>Tüm haberler <span aria-hidden="true">↗</span></a></div>
    <div class="news-grid mt-9">{latestNews.map((item, i) => <a href={url(`/haberler#${item.id}`)} class:list={['news-story group reveal', i === 0 && 'news-story-lead']}>
      {media(item.data.image) && <div class="news-photo"><img src={media(item.data.image)} alt={item.data.title} loading="lazy" decoding="async" /></div>}
      <div class="news-copy"><div class="news-meta"><span>{item.data.type}</span><time datetime={item.data.date.toISOString()}>{dateFmt.format(item.data.date)}</time></div><h3>{item.data.title}</h3><p>{item.data.summary}</p><span class="text-link">Haberi oku <span aria-hidden="true">↗</span></span></div>
    </a>)}</div>
  </Section>}

  <Section eyebrow="2025–2026 Destekçilerimiz" title="Üretmenin arkasında birlikte duruyoruz." class="home-sponsors">
    <div class="section-action"><a class="text-link" href={url('/sponsorluk')}>Tüm sponsorlar ve detaylar <span aria-hidden="true">↗</span></a></div>

    <!-- Platin Sponsorlar -->
    <div class="mt-8">
      <div class="mb-3 flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-volt-400" aria-hidden="true"></span>
        <h3 class="font-mono text-[0.68rem] tracking-[0.2em] text-volt-300 uppercase">Platin Sponsorlar</h3>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        {platinSponsors.map((s) => (
          <a href={url('/sponsorluk')} class="card flex flex-col items-center justify-center p-5 text-center transition-transform hover:scale-[1.02]">
            {media(s.logo) && <img src={media(s.logo)!} alt={s.name} loading="lazy" decoding="async" class="h-16 w-16 rounded-full object-contain ring-1 ring-white/10" />}
            <span class="mt-3 text-sm font-bold text-mist-100">{s.name}</span>
            <span class="mt-1 font-mono text-[0.62rem] text-volt-300 uppercase">{s.type}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Altın & Gümüş Sponsorlar -->
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div>
        <div class="mb-3 flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-medal-400" aria-hidden="true"></span>
          <h3 class="font-mono text-[0.68rem] tracking-[0.2em] text-medal-400 uppercase">Altın Sponsorlar</h3>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {altinSponsors.map((s) => (
            <a href={url('/sponsorluk')} class="card flex items-center gap-3 p-4 transition-transform hover:scale-[1.02]">
              {media(s.logo) && <img src={media(s.logo)!} alt={s.name} loading="lazy" decoding="async" class="h-12 w-12 shrink-0 rounded-full object-contain ring-1 ring-white/10" />}
              <div class="min-w-0">
                <span class="block text-xs font-bold text-mist-100 truncate">{s.name}</span>
                <span class="block font-mono text-[0.6rem] text-medal-400">{s.type}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="mb-3 flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-mist-300" aria-hidden="true"></span>
          <h3 class="font-mono text-[0.68rem] tracking-[0.2em] text-mist-300 uppercase">Gümüş Sponsor</h3>
        </div>
        <div class="grid gap-3">
          {gumusSponsors.map((s) => (
            <a href={url('/sponsorluk')} class="card flex items-center gap-3 p-4 transition-transform hover:scale-[1.02]">
              {media(s.logo) && <img src={media(s.logo)!} alt={s.name} loading="lazy" decoding="async" class="h-12 w-12 shrink-0 rounded-full object-contain ring-1 ring-white/10" />}
              <div class="min-w-0">
                <span class="block text-xs font-bold text-mist-100 truncate">{s.name}</span>
                <span class="block font-mono text-[0.6rem] text-mist-300">{s.type}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bronz Sponsorlar -->
    <div class="mt-6">
      <div class="mb-3 flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-ember-400" aria-hidden="true"></span>
        <h3 class="font-mono text-[0.68rem] tracking-[0.2em] text-ember-400 uppercase">Bronz Sponsorlar</h3>
      </div>
      <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {bronzSponsors.map((s) => (
          <a href={url('/sponsorluk')} class="card flex flex-col items-center justify-center p-3 text-center transition-transform hover:scale-[1.02]">
            {media(s.logo) ? (
              <img src={media(s.logo)!} alt={s.name} loading="lazy" decoding="async" class="h-11 w-11 rounded-full object-contain ring-1 ring-white/10" />
            ) : (
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/5 font-mono text-sm font-bold text-white/20 ring-1 ring-white/10">
                {s.name.charAt(0)}
              </div>
            )}
            <span class="mt-2 text-xs font-semibold text-mist-200 line-clamp-1">{s.name}</span>
            <span class="mt-0.5 font-mono text-[0.58rem] text-mist-500 truncate">{s.type}</span>
          </a>
        ))}
      </div>
    </div>
  </Section>

  <CtaBand title="Sıradaki projede sen de ol." description="İlgilendiğin yolu seç: topluluk kaydı, takım başvurusu veya yönetim kuruluna katılım." primary={{label:'Topluluk kaydına başla',href:'/bize-katilin#topluluk-kaydi'}} secondary={{label:'Bizi tanı',href:'/hakkimizda'}}>
    <BasvuruButonlari align="center" class="mt-10 border-t border-white/8 pt-8" />
  </CtaBand>
</BaseLayout>

<style>
  .home-hero { padding-top: 2.5rem; }
  .hero-topline,.hero-bottom { display:flex; justify-content:space-between; gap:1.5rem; align-items:center; }
  .hero-about { font-size:.78rem; color:var(--color-mist-300); white-space:nowrap; }
  .hero-about span { margin-left:1rem; color:var(--color-volt-400); }
  .hero-heading { display:grid; grid-template-columns:1.6fr 1fr; gap:4rem; align-items:end; padding:2.7rem 0 3rem; }
  h1 { white-space:pre-line; font-size:clamp(3.3rem,6.1vw,6rem); font-weight:600; line-height:1.02; letter-spacing:-.047em; text-wrap:initial; }
  .hero-intro>p { font-size:1rem; line-height:1.85; color:var(--color-mist-300); max-width:39ch; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1.5rem; margin-top:1.6rem; }
  .hero-photo img { width:100%; height:clamp(300px,32vw,470px); object-fit:cover; object-position:50% 57%; }
  .hero-photo figcaption { display:flex; gap:1rem; justify-content:space-between; padding:.85rem 0; font-size:.72rem; color:var(--color-mist-300); border-bottom:1px solid var(--edge); }
  .hero-photo figcaption a { color:var(--color-mist-100); }
  .hero-bottom { padding:1.2rem 0; font-size:.72rem; color:var(--color-mist-500); }
  .hero-bottom a { color:var(--color-mist-300); }
  .notice-strip { display:grid; grid-template-columns:110px 1fr; gap:2rem; margin-top:1rem; }
  .notice-strip>.eyebrow { padding:1.1rem 0; }
  .notice-strip>div { border-top:1px solid var(--edge); }
  .notice-strip a { display:flex; justify-content:space-between; gap:1rem; padding:1rem 0; border-bottom:1px solid var(--edge); font-size:.85rem; }
  .notice-strip a:hover { color:var(--color-volt-400); }
  .section-action { display:flex; justify-content:flex-end; margin-top:-1.7rem; }
  .teams-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:3rem 1.6rem; margin-top:2.5rem; }
  .achievement-row { display:grid; grid-template-columns:90px 1fr 240px; align-items:center; gap:2rem; padding:1.5rem 0; border-top:1px solid var(--edge); }
  .achievement-row:last-child { border-bottom:1px solid var(--edge); }
  .achievement-year { font-family:var(--font-mono); font-size:.8rem; color:var(--color-mist-500); }
  .achievement-row h3 { font-size:1.3rem; font-weight:600; }
  .achievement-row p { font-size:.8rem; color:var(--color-mist-500); margin-top:.35rem; }
  .achievement-result { display:flex; flex-direction:column; gap:.4rem; text-align:right; }
  .achievement-result strong { font-family:var(--font-display); font-size:1.25rem; font-weight:600; }
  .achievement-result a,.achievement-result>span { font-size:.75rem; color:var(--color-mist-300); }
  .news-grid { display:grid; grid-template-columns:1.15fr 1fr; gap:2rem 3rem; }
  .news-story-lead { grid-row:span 2; }
  .news-story:not(.news-story-lead) { display:grid; grid-template-columns:140px 1fr; gap:1.4rem; padding-bottom:1.7rem; border-bottom:1px solid var(--edge); }
  .news-photo { align-self:start; overflow:hidden; background:var(--color-ink-800); }
  .news-photo img { width:100%; aspect-ratio:4/3; object-fit:cover; transition:transform .4s; }
  .news-story:hover img { transform:scale(1.025); }
  .news-story:not(.news-story-lead) img { aspect-ratio:1; }
  .news-story-lead .news-copy { padding-top:1.3rem; }
  .news-meta { display:flex; flex-wrap:wrap; gap:.6rem 1rem; color:var(--color-mist-500); font-size:.68rem; }
  .news-meta>span { color:var(--color-volt-400); }
  .news-story h3 { font-size:1.45rem; font-weight:600; line-height:1.2; margin-top:.65rem; }
  .news-story-lead h3 { font-size:1.9rem; }
  .news-copy>p { font-size:.85rem; line-height:1.7; color:var(--color-mist-300); margin-top:.8rem; }
  .news-copy>.text-link { margin-top:1.3rem; }
  .sponsor-wall { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); border-top:1px solid var(--edge); border-left:1px solid var(--edge); }
  .sponsor-wall li { border-right:1px solid var(--edge); border-bottom:1px solid var(--edge); }
  .sponsor-wall a { min-height:160px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem; padding:1.3rem .7rem; transition:background .2s; }
  .sponsor-wall a:hover { background:var(--color-ink-800); }
  .sponsor-wall img { object-fit:contain; }
  .sponsor-wall span { font-size:.72rem; color:var(--color-mist-300); text-align:center; }
  @media(max-width:1050px) { .hero-heading { gap:2rem; grid-template-columns:1.4fr 1fr; } .hero-actions { gap:1rem; } .section-action { margin-top:1.5rem; justify-content:flex-start; } .sponsor-wall { grid-template-columns:repeat(4,minmax(0,1fr)); } }
  @media(max-width:767px) { .home-hero { padding-top:1.7rem; } .hero-topline .eyebrow { max-width:27ch; font-size:.6rem; } .hero-about { font-size:.7rem; } .hero-heading { grid-template-columns:1fr; gap:1.5rem; padding:2rem 0; } h1 { font-size:clamp(2.6rem,8.6vw,4.3rem); } .hero-intro>p { font-size:.9rem; max-width:48ch; } .hero-photo img { height:auto; aspect-ratio:4/3; } .hero-photo figcaption { font-size:.65rem; } .hero-bottom { align-items:flex-start; font-size:.65rem; } .hero-bottom p { max-width:27ch; } .hero-bottom a { max-width:20ch; text-align:right; } .notice-strip { grid-template-columns:1fr; gap:0; } .teams-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:2.5rem 1rem; } .achievement-row { grid-template-columns:40px 1fr; gap:1rem; } .achievement-result { grid-column:2; text-align:left; flex-direction:row; align-items:center; justify-content:space-between; } .achievement-row h3 { font-size:1.1rem; } .achievement-result strong { font-size:1rem; } .news-grid { grid-template-columns:1fr; gap:2rem; } .news-story:not(.news-story-lead) { grid-template-columns:100px 1fr; gap:1rem; } .sponsor-wall { grid-template-columns:repeat(3,minmax(0,1fr)); } .sponsor-wall a { min-height:145px; } }
  @media(max-width:480px) { .teams-grid { grid-template-columns:1fr; } .hero-about span { margin-left:.3rem; } .hero-actions { gap:1.25rem; } }
</style>
