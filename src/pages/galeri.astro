---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { getCollection } from 'astro:content';
import gallery from '../data/gallery.json';
import { media, url } from '../lib/utils';

type GaleriGorseli = { image: string; caption?: string; category?: string; takim?: string };
const images = (gallery.images as GaleriGorseli[]).filter((img) => Boolean(img.image?.trim()));

// Kategori filtreleri: sabit sırada, yalnızca görseli olan kategoriler gösterilir.
const KATEGORI_SIRASI = ['Yarışma', 'Atölye', 'Araçlar', 'Ödül ve Derece', 'Teknik Gezi', 'Etkinlik', 'Tasarım', 'Sponsor'];
const kategoriler = KATEGORI_SIRASI.map((ad) => ({ ad, sayi: images.filter((i) => i.category === ad).length })).filter((k) => k.sayi > 0);

// Takım filtresi ve bağlantıları: görseldeki `takim` alanı takım sayfasının dosya adıdır.
const takimlar = new Map((await getCollection('teams')).map((t) => [t.id, t.data]));
const takimSecenekleri = [...new Set(images.map((i) => i.takim).filter((t): t is string => Boolean(t && takimlar.has(t))))]
  .map((id) => ({ id, ad: takimlar.get(id)!.title, sira: takimlar.get(id)!.order }))
  .sort((a, b) => a.sira - b.sira);
---

<BaseLayout
  title="Galeri"
  description="MATRO atölyesinden, TEKNOFEST yarışma alanlarından, teknik gezilerden ve ödül törenlerinden kareler."
>
  <PageHero eyebrow="Galeri" title="Atölyeden sahaya" description={gallery.intro} />

  <Section>
    {
      images.length > 0 && (
        <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex flex-wrap gap-2" role="group" aria-label="Kategoriye göre filtrele">
            <button type="button" data-kategori="" aria-pressed="true" class="galeri-filtre rounded-lg border border-volt-400/50 bg-volt-400/10 px-3.5 py-2 font-mono text-xs tracking-wider text-volt-300 transition-colors">
              TÜMÜ <span class="opacity-60">{images.length}</span>
            </button>
            {kategoriler.map((k) => (
              <button type="button" data-kategori={k.ad} aria-pressed="false" class="galeri-filtre rounded-lg border border-white/12 px-3.5 py-2 font-mono text-xs tracking-wider text-mist-300 uppercase transition-colors hover:border-white/25 hover:text-mist-100">
                {k.ad} <span class="opacity-60">{k.sayi}</span>
              </button>
            ))}
          </div>
          <label class="flex items-center gap-2 text-xs text-mist-500">
            <span class="font-mono tracking-[0.15em] uppercase">Takım</span>
            <select id="galeri-takim" class="rounded-lg border border-white/12 bg-ink-900 px-3 py-2 text-sm text-mist-100 focus:border-volt-400/50 focus:outline-none">
              <option value="">Tüm takımlar</option>
              {takimSecenekleri.map((t) => <option value={t.id}>{t.ad}</option>)}
            </select>
          </label>
        </div>
      )
    }
    <p id="galeri-bos" class="hidden py-10 text-center text-sm text-mist-500">Bu seçimde görsel yok.</p>
    {
      images.length > 0 ? (
        <div id="galeri-akis" data-lightbox-grup class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4">
          {images.map((img, i) => (
            <figure class="galeri-oge card reveal group overflow-hidden break-inside-avoid" data-delay={(i % 3) * 55} data-kategori={img.category ?? ''} data-takim={img.takim ?? ''}>
              <img
                src={media(img.image)!}
                alt={img.caption || 'MATRO galeri görseli'}
                data-lightbox
                loading="lazy"
                decoding="async"
                class="w-full transition-transform duration-500 group-hover:scale-[1.03]"
              />
              {(img.caption || img.category || img.takim) && (
                <figcaption class="border-t border-white/8 p-4">
                  {img.category && (
                    <span class="font-mono text-[0.62rem] tracking-[0.15em] text-volt-400 uppercase">
                      {img.category}
                    </span>
                  )}
                  {img.caption && <p class="mt-1 text-sm text-mist-300">{img.caption}</p>}
                  {img.takim && takimlar.has(img.takim) && (
                    <a href={url(`/takimlarimiz/${img.takim}`)} class="mt-2 inline-block text-xs font-semibold text-volt-400 hover:text-volt-300">
                      {takimlar.get(img.takim)!.title} ↗
                    </a>
                  )}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      ) : (
        <div class="card grid-bg flex flex-col items-center justify-center px-6 py-20 text-center">
          <svg
            class="h-10 w-10 text-white/15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="8.5" cy="9.5" r="1.5" />
            <path d="m4 17 5-5 4 4 3-3 4 4" />
          </svg>
          <h2 class="mt-5 text-lg font-bold text-mist-100">Galeri henüz boş</h2>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-mist-500">
            Fotoğrafları eklemek için içerik paneline gir, <strong class="text-mist-300">Galeri</strong>{' '}
            bölümünden görsel yükle ve kaydet. Yüklediğin görseller birkaç dakika içinde burada
            yayına girer.
          </p>
        </div>
      )
    }
  </Section>
</BaseLayout>

<script>
  const ogeler = Array.from(document.querySelectorAll<HTMLElement>('.galeri-oge'));
  const dugmeler = Array.from(document.querySelectorAll<HTMLButtonElement>('.galeri-filtre'));
  const takimSecimi = document.getElementById('galeri-takim') as HTMLSelectElement | null;
  const bos = document.getElementById('galeri-bos');
  const ACIK = ['border-volt-400/50', 'bg-volt-400/10', 'text-volt-300'];
  const KAPALI = ['border-white/12', 'text-mist-300'];
  let kategori = '';

  // Filtre seçimi adres çubuğuna da yazılır (?kategori=Araçlar&takim=...), böylece
  // takım sayfalarından veya menüden doğrudan filtreli galeriye bağlantı verilebilir.
  const parametreler = new URLSearchParams(location.search);
  kategori = parametreler.get('kategori') ?? '';
  if (takimSecimi) takimSecimi.value = parametreler.get('takim') ?? '';

  function uygula() {
    const takim = takimSecimi?.value ?? '';
    let gorunen = 0;
    ogeler.forEach((o) => {
      const goster = (!kategori || o.dataset.kategori === kategori) && (!takim || o.dataset.takim === takim);
      o.classList.toggle('hidden', !goster);
      if (goster) gorunen += 1;
    });
    dugmeler.forEach((b) => {
      const acik = (b.dataset.kategori ?? '') === kategori;
      b.setAttribute('aria-pressed', String(acik));
      b.classList.remove(...ACIK, ...KAPALI);
      b.classList.add(...(acik ? ACIK : KAPALI));
    });
    bos?.classList.toggle('hidden', gorunen > 0);
    const yeni = new URLSearchParams();
    if (kategori) yeni.set('kategori', kategori);
    if (takim) yeni.set('takim', takim);
    history.replaceState(null, '', yeni.toString() ? `?${yeni}` : location.pathname);
  }

  dugmeler.forEach((b) => b.addEventListener('click', () => { kategori = b.dataset.kategori ?? ''; uygula(); }));
  takimSecimi?.addEventListener('change', uygula);
  uygula();
</script>
