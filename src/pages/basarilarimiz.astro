---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FotoSerit from '../components/FotoSerit.astro';
import Section from '../components/Section.astro';
import StatGrid from '../components/StatGrid.astro';
import AchievementsExplorer from '../components/AchievementsExplorer.astro';
import CtaBand from '../components/CtaBand.astro';
import achievements from '../data/achievements.json';
import { getCollection } from 'astro:content';
import { teamIndex } from '../lib/utils';

const items = achievements.items;
const takimDizini = teamIndex(await getCollection('teams'));
const years = [...new Set(items.map((i) => i.year))];
// "31.lik" gibi kayıtlar birinciliğe sayılmasın diye 1'in önünde rakam olmamalı
const firstPlaces = items.filter((i) => /(^|[^0-9])1\./.test(i.degree)).length;
const finalists2026 = items.filter((i) => i.year === 2026 && /finalist/i.test(i.degree)).length;
const international = items.filter((i) =>
  /dünya|singapore|france|nasa|italian|uluslararası|bölge/i.test(`${i.competition} ${i.degree}`)
).length;

const stats = [
  { value: items.length, suffix: '', label: 'Kayıtlı Derece', note: `${Math.min(...years)}–${Math.max(...years)}` },
  { value: firstPlaces, suffix: '', label: 'Birincilik', note: 'Türkiye ve bölge' },
  { value: international, suffix: '', label: 'Uluslararası Başarı', note: 'Dünya çapında' },
  { value: 342, suffix: '', label: 'Finalist Yarışmacı', note: '2020–2025' },
  { value: 35, suffix: '', label: "İlk 10'a Giren Takım", note: '2020–2025' },
  { value: finalists2026, suffix: '', label: 'TEKNOFEST Finalisti', note: '2026 sezonu' },
];
---

<BaseLayout
  title="Başarılarımız"
  description="MATRO'nun 2013'ten bugüne TEKNOFEST, NASA Space Apps, Renault Twizy Contest ve Singapore SAUVC gibi ulusal ve uluslararası yarışmalarda kazandığı tüm dereceler."
>
  <PageHero
    eyebrow="Başarılarımız"
    title={`${items.length} kayıtlı derece, ${firstPlaces} birincilik`}
    description={achievements.intro}
  />

  <Section>
    <StatGrid stats={stats} />
  </Section>

  <Section
    eyebrow="Tam Liste"
    title="Dereceler ve ödüller"
    description="Yıla göre filtreleyebilir veya yarışma, takım ve kategori adıyla arama yapabilirsin."
    class="pt-0"
  >
    <AchievementsExplorer items={items} teams={takimDizini} />
  </Section>

  <Section eyebrow="Kareler" title="Yarışma alanından" class="pt-0">
    <FotoSerit categories={['Yarışma']} limit={6} class="mt-10" />
  </Section>

  <CtaBand
    title="Bu listeye sen de bir satır ekle"
    description="Her derecenin arkasında atölyede geçirilmiş yüzlerce saat var. Aramıza katıl, bir sonraki başarının parçası ol."
    primary={{ label: 'Bize Katılın', href: '/bize-katilin' }}
    secondary={{ label: 'Takımlarımız', href: '/takimlarimiz' }}
  />
</BaseLayout>
