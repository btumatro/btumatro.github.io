---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import BasvuruButonlari from '../../components/BasvuruButonlari.astro';
import { instagramUrl, url, media } from '../../lib/utils';

export async function getStaticPaths() {
  const teams = await getCollection('teams');
  return teams.map((team) => ({
    params: { slug: team.id },
    props: { team },
  }));
}

interface Props {
  team: CollectionEntry<'teams'>;
}

const { team } = Astro.props;
const { Content } = await render(team);
const cover = media(team.data.image);
const takimInstagram = instagramUrl(team.data.instagram);

const others = (await getCollection('teams'))
  .filter((t) => t.id !== team.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={team.data.title} description={team.data.summary}>
  <article>
    <!-- Başlık -->
    <header class="relative overflow-hidden border-b border-white/10">
      <div class="grid-bg absolute inset-0 opacity-50" aria-hidden="true"></div>
      <div
        class="absolute -top-40 left-1/4 h-[24rem] w-[40rem] rounded-full bg-volt-500/12 blur-[110px]"
        aria-hidden="true"
      >
      </div>

      <div class="container-matro relative py-14 md:py-20">
        <a
          href={url('/takimlarimiz')}
          class="inline-flex items-center gap-1.5 text-sm text-mist-500 transition-colors hover:text-volt-300"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 6l-6 6 6 6"></path>
          </svg>
          Takımlarımız
        </a>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="rounded-md border border-white/12 px-2.5 py-1 font-mono text-[0.65rem] tracking-wider text-mist-300 uppercase">
            {team.data.category}
          </span>
          {
            team.data.status === 'Yeni Takım' && (
              <span class="rounded-md bg-volt-400/90 px-2.5 py-1 font-mono text-[0.65rem] font-semibold tracking-wider text-ink-950 uppercase">
                Yeni Takım
              </span>
            )
          }
          {
            team.data.badge && (
              <span class="rounded-md bg-medal-500/90 px-2.5 py-1 font-mono text-[0.65rem] font-semibold tracking-wider text-ink-950 uppercase">
                {team.data.badge}
              </span>
            )
          }
        </div>

        <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">{team.data.title}</h1>
        {team.data.subtitle && <p class="mt-2 text-lg text-volt-400">{team.data.subtitle}</p>}
        {
          team.data.summary && (
            <p class="mt-5 max-w-2xl leading-relaxed text-mist-300">{team.data.summary}</p>
          )
        }

        {
          takimInstagram && (
            <a
              href={takimInstagram}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center gap-2 rounded-xl border border-white/15 px-4 py-2.5 text-sm font-semibold text-mist-100 transition-colors hover:border-volt-400/50 hover:text-volt-300"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
              Takımın Instagram sayfası
            </a>
          )
        }
      </div>
    </header>

    {
      cover && (
        <div class="container-matro">
          <img
            src={cover}
            alt={`${team.data.title} takımı`}
            class="mx-auto mt-10 aspect-[16/9] w-full max-w-3xl rounded-2xl border border-white/10 object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }

    <div class="container-matro grid gap-12 py-14 md:py-20 lg:grid-cols-[1.5fr_1fr]">
      <div class="prose-matro reveal max-w-none">
        <Content />
      </div>

      <aside class="space-y-5">
        {
          team.data.focus.length > 0 && (
            <div class="card reveal p-6">
              <h2 class="font-mono text-[0.65rem] tracking-[0.2em] text-mist-500 uppercase">
                Odak Alanları
              </h2>
              <ul class="mt-4 space-y-2.5">
                {team.data.focus.map((f) => (
                  <li class="flex gap-2.5 text-sm text-mist-300">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rotate-45 rounded-[1px] bg-volt-500"
                      aria-hidden="true"
                    />
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          team.data.achievements.length > 0 && (
            <div class="card reveal p-6" data-delay="80">
              <h2 class="font-mono text-[0.65rem] tracking-[0.2em] text-mist-500 uppercase">
                Dereceler ve Ödüller
              </h2>
              <ul class="mt-4 space-y-3">
                {team.data.achievements.map((a) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-mist-300">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-medal-400"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 2 9.2 8.6 2 9.2l5.5 4.7L5.8 21 12 17.3 18.2 21l-1.7-7.1L22 9.2l-7.2-.6L12 2Z" />
                    </svg>
                    {a}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <!-- Diğer takımlar -->
    <section class="container-matro border-t border-white/10 py-14">
      <h2 class="text-xl font-bold tracking-tight">Diğer takımlarımız</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          others.map((t) => (
            <a href={url(`/takimlarimiz/${t.id}`)} class="card card-hover group p-5">
              <h3 class="text-base font-bold text-mist-100 transition-colors group-hover:text-volt-300">
                {t.data.title}
              </h3>
              <p class="mt-1 text-xs text-volt-400">{t.data.subtitle}</p>
              <p class="mt-3 line-clamp-2 text-sm text-mist-500">{t.data.summary}</p>
            </a>
          ))
        }
      </div>
    </section>
  </article>

  <CtaBand
    title={`${team.data.title} takımında yer al`}
    description="Takım ön başvuru formunda en fazla üç takım tercihi yapabilirsin."
    primary={{ label: 'Bize Katılın', href: '/bize-katilin' }}
    secondary={{ label: 'İletişim', href: '/iletisim' }}
  >
    <BasvuruButonlari align="center" class="mt-10 border-t border-white/8 pt-8" />
  </CtaBand>
</BaseLayout>
