---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import TeamCard from '../../components/TeamCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import BasvuruButonlari from '../../components/BasvuruButonlari.astro';
import about from '../../data/about.json';

const teams = (await getCollection('teams'))
  .filter((t) => t.data.status !== 'Arşiv')
  .sort((a, b) => a.data.order - b.data.order);

const categories = [...new Set(teams.map((t) => t.data.category))].sort((a, b) =>
  a.localeCompare(b, 'tr')
);
---

<BaseLayout
  title="Takımlarımız"
  description="ASHİNA, BÜRKÜT, ÇAĞRI, TİKA, İSS ve daha fazlası — MATRO bünyesinde faaliyet gösteren proje takımları ve çalışma alanları."
>
  <PageHero
    eyebrow="Proje ekipleri"
    title="Takımlarımız."
    description="Hava, kara, deniz ve dijital teknolojiler. Merak ettiğin çalışma alanını seç, o alanda üreten ekiple tanış."
  >
  </PageHero>

  <Section class="pt-8 md:pt-10">
    <div class="team-filter-bar">
      <p id="team-count" aria-live="polite">{teams.length} takım</p>
      <div id="team-filters" hidden role="group" aria-label="Çalışma alanına göre filtrele">
        <button type="button" data-filter="" aria-pressed="true">Tümü</button>
        {categories.map(c => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
      </div>
    </div>
    <div id="team-results" class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        teams.map((team, i) => (
          <TeamCard
            slug={team.id}
            title={team.data.title}
            subtitle={team.data.subtitle}
            category={team.data.category}
            status={team.data.status}
            badge={team.data.badge}
            summary={team.data.summary}
            image={team.data.image}
            focus={team.data.focus}
            delay={(i % 3) * 60}
          />
        ))
      }
    </div>
  </Section>

  <Section
    eyebrow="2026 Hedeflerimiz"
    title={about.goals2026.title}
    description={about.goals2026.description}
    class="pt-0"
  >
    <ol class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        about.goals2026.items.map((item, i) => (
          <li class="card reveal flex items-center gap-3 p-4" data-delay={(i % 4) * 50}>
            <span class="font-mono text-lg font-bold text-white/12">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-sm font-medium text-mist-100">{item}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  <CtaBand
    title="Hangi takımda yer almak istersin?"
    description="Bölüm ayrımı yok. Başvurunda ilgilendiğin alanı belirt, seni doğru takıma yönlendirelim."
    primary={{ label: 'Takım başvurusu', href: '/bize-katilin#takim-basvurusu' }}
    secondary={{ label: 'Başarılarımız', href: '/basarilarimiz' }}
  >
    <BasvuruButonlari align="center" class="mt-10 border-t border-white/8 pt-8" />
  </CtaBand>
</BaseLayout>

<style>
  .team-filter-bar { border-bottom:1px solid var(--edge); margin-bottom:2rem; padding-bottom:1rem; }
  #team-count { font-family:var(--font-mono); font-size:.75rem; color:var(--color-mist-500); margin-bottom:1rem; }
  #team-filters:not([hidden]) { display:flex; flex-wrap:wrap; gap:.35rem 1.4rem; }
  #team-filters button { cursor:pointer; padding:.7rem 0; font-size:.75rem; color:var(--color-mist-300); border-bottom:2px solid transparent; }
  #team-filters button[aria-pressed="true"] { color:var(--color-volt-400); border-color:var(--color-volt-400); }
  #team-filters button:hover { color:var(--color-mist-100); }
  :global(#team-results .team-card[hidden]) { display:none; }
</style>
<script>
  const filters = document.getElementById('team-filters');
  const cards = document.querySelectorAll<HTMLElement>('#team-results [data-category]');
  const count = document.getElementById('team-count');
  if (filters && count) {
    filters.hidden = false;
    filters.querySelectorAll<HTMLButtonElement>('button').forEach(button => {
      button.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach(other => other.setAttribute('aria-pressed', String(other === button)));
        let visible = 0;
        cards.forEach(card => {
          card.hidden = Boolean(button.dataset.filter && card.dataset.category !== button.dataset.filter);
          if (!card.hidden) { visible++; card.classList.add('is-visible'); }
        });
        count.textContent = `${visible} takım`;
      });
    });
  }
</script>
