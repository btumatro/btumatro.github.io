---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import MediaGaleri from '../components/MediaGaleri.astro';

const activities = (await getCollection('activities')).sort(
  (a, b) => a.data.order - b.data.order
);

const rendered = await Promise.all(
  activities.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  }))
);

const dateFmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Faaliyetlerimiz"
  description="MATRO eğitim kampları, teknik geziler, seminerler, mentörlük programları ve sosyal sorumluluk projeleri."
>
  <PageHero
    eyebrow="Faaliyetlerimiz"
    title="Sadece yarışmıyoruz; öğretiyor, geziyor, paylaşıyoruz"
    description="Yeni üyelerimize verdiğimiz eğitimlerden dev tesislere düzenlediğimiz teknik gezilere, sosyal sorumluluk projelerinden sektörel söyleşilere kadar yıl boyu süren faaliyetlerimiz."
  />

  <Section>
    <div class="space-y-5">
      {
        rendered.map(({ entry, Content }, i) => {
          return (
            <article class="card reveal overflow-hidden" data-delay={i * 50}>
              <div class="grid md:grid-cols-[1fr_1.6fr]">
                <div class="relative flex min-h-[10rem] flex-col border-b border-white/8 bg-ink-800 md:border-r md:border-b-0">
                  <MediaGaleri
                    cover={entry.data.image}
                    gallery={entry.data.gallery}
                    alt={entry.data.title}
                    placeholderLabel={entry.data.type}
                    stretch
                      imgClass="aspect-[4/3] w-full flex-1 object-cover md:aspect-auto"
                  />
                </div>

                <div class="p-6 md:p-8">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-md bg-volt-400/10 px-2.5 py-1 font-mono text-[0.65rem] tracking-wider text-volt-300 uppercase">
                      {entry.data.type}
                    </span>
                    <span class="font-mono text-[0.7rem] text-mist-500">
                      {dateFmt.format(entry.data.date)}
                      {entry.data.endDate && ` – ${dateFmt.format(new Date(entry.data.endDate))}`}
                    </span>
                  </div>

                  <h2 class="mt-3 text-xl font-bold tracking-tight text-mist-100">
                    {entry.data.title}
                  </h2>
                  <p class="mt-2 leading-relaxed text-mist-300">{entry.data.summary}</p>

                  {entry.data.stats.length > 0 && (
                    <dl class="mt-5 flex flex-wrap gap-6">
                      {entry.data.stats.map((s) => (
                        <div>
                          <dt class="font-mono text-[0.65rem] tracking-wider text-mist-500 uppercase">
                            {s.label}
                          </dt>
                          <dd class="mt-0.5 font-mono text-lg font-bold text-volt-300">{s.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  <details class="group mt-5">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-semibold text-volt-400 hover:text-volt-300">
                      Detayları gör
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        class="transition-transform group-open:rotate-180"
                      >
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <div class="prose-matro mt-4 border-t border-white/8 pt-4 text-sm">
                      <Content />
                    </div>
                  </details>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <CtaBand
    title="Eğitim kampımıza katılmak ister misin?"
    description="Her dönem yeni üyelerimiz için mekanik, elektronik ve yazılım alanlarında sertifikalı eğitim programı düzenliyoruz."
    primary={{ label: 'Bize Katılın', href: '/bize-katilin' }}
    secondary={{ label: 'İletişim', href: '/iletisim' }}
  />
</BaseLayout>
