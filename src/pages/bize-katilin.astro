---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import join from '../data/join.json';
import site from '../data/site.json';
import { url } from '../lib/utils';

const instagram = site.social.find((s) => s.platform === 'Instagram')?.url ?? '#';
const hasForm = Boolean(join.applicationFormUrl?.trim());
const applications = (join.applications ?? []).filter((a) => a.url?.trim());
---

<BaseLayout
  title="Bize Katılın"
  description="MATRO'ya nasıl katılırsın? Başvuru süreci, sık sorulan sorular ve topluluğa katılmanın sağladığı imkânlar."
>
  <PageHero eyebrow={join.hero.eyebrow} title={join.hero.title} description={join.hero.description}>
    <div class="reveal mt-8 flex flex-wrap gap-3" data-delay="180">
      {
        hasForm ? (
          <a
            href={join.applicationFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-volt-400 px-6 py-3.5 text-sm font-semibold text-ink-950 transition-transform hover:scale-[1.03]"
          >
            Başvuru formunu doldur
          </a>
        ) : (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-volt-400 px-6 py-3.5 text-sm font-semibold text-ink-950 transition-transform hover:scale-[1.03]"
          >
            Başvuru duyuruları için Instagram
          </a>
        )
      }
      <a
        href={url('/takimlarimiz')}
        class="rounded-xl border border-white/15 px-6 py-3.5 text-sm font-semibold text-mist-100 transition-colors hover:border-volt-400/50 hover:text-volt-300"
      >
        Takımları incele
      </a>
    </div>

    {
      !hasForm && (
        <p class="reveal mt-4 text-xs text-mist-500" data-delay="220">
          Başvuru formu bağlantısı henüz eklenmedi. Ekleyene kadar başvurular Instagram üzerinden
          duyurulur.
        </p>
      )
    }
  </PageHero>

  <!-- Başvuru formları -->
  {
    applications.length > 0 && (
      <Section
        eyebrow="Başvuru Formları"
        title="Açık başvurular"
        description={join.applicationPeriod}
      >
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {applications.map((a, i) => (
            <article class="card reveal flex flex-col p-6" data-delay={i * 60}>
              <span class="font-mono text-[0.62rem] tracking-[0.2em] text-mist-500 uppercase">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 text-base font-bold text-mist-100">{a.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-mist-500">{a.description}</p>
              <a
                href={a.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-block rounded-xl border border-white/15 px-4 py-2.5 text-center text-sm font-semibold text-mist-100 transition-colors hover:border-volt-400/50 hover:text-volt-300"
              >
                {a.buttonLabel}
              </a>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <!-- Süreç -->
  <Section eyebrow="Başvuru Süreci" title="Dört adımda MATRO'lu ol" class="pt-0">
    <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        join.steps.map((step, i) => (
          <li class="card reveal relative p-6" data-delay={i * 60}>
            <span class="font-mono text-3xl font-bold text-white/8">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-base font-bold text-mist-100">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist-500">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Neden -->
  <Section eyebrow="Neden MATRO?" title="Katıldığında ne kazanırsın?" class="pt-0">
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        join.whyJoin.map((item, i) => (
          <article class="card reveal p-6" data-delay={i * 55}>
            <h3 class="text-base font-bold text-mist-100">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist-500">{item.description}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- SSS -->
  <Section eyebrow="SSS" title="Sık sorulan sorular" class="pt-0">
    <div class="mt-10 space-y-3">
      {
        join.faq.map((item, i) => (
          <details class="card reveal group p-5" data-delay={i * 45}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-mist-100">
              {item.question}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
                class="shrink-0 text-volt-400 transition-transform group-open:rotate-45"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="mt-3 border-t border-white/8 pt-3 text-sm leading-relaxed text-mist-300">
              {item.answer}
            </p>
          </details>
        ))
      }
    </div>
  </Section>
</BaseLayout>
