---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  id?: string;
  class?: string;
  align?: 'left' | 'center';
}
const {
  eyebrow,
  title,
  description,
  id,
  class: className = '',
  align = 'left',
} = Astro.props;
---

<section id={id} class={`container-matro section-matro py-14 md:py-20 ${className}`}>
  {
    (eyebrow || title || description) && (
      <header class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}>
        {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
        {title && (
          <h2 class="reveal mt-3 text-4xl leading-[1.08] font-semibold tracking-tight md:text-5xl" data-delay="60">
            {title}
          </h2>
        )}
        {description && (
          <p class="reveal mt-4 leading-relaxed text-mist-300" data-delay="110">
            {description}
          </p>
        )}
      </header>
    )
  }
  <slot />
</section>
