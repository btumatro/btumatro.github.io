---
/**
 * Başarılar gezgini.
 *
 * Varsayılan görünüm "Dereceye göre": kayıtlar DERECE_GRUPLARI'na ayrılır
 * (birincilikler, ikincilikler, üçüncülükler, ilk 10, rapor dereceleri ve özel
 * ödüller, finalistlikler) ve her grup kendi içinde önce dereceye, sonra yıla göre
 * sıralanır. "Yıla göre" görünümü aynı kayıtları yeniden eskiye tek listede gösterir.
 * Yıl düğmeleri ve arama kutusu iki görünümde de çalışır.
 */
import { DERECE_GRUPLARI, degreeRank, degreeTone, teamHref } from '../lib/utils';

interface Achievement {
  year: number;
  competition: string;
  category: string;
  degree: string;
  team?: string;
  featured?: boolean;
}
interface Props {
  items: Achievement[];
  /** Takım adı → sayfa eşlemesi; verilirse takım adları sayfasına bağlanır. */
  teams?: Map<string, string>;
}
const { items, teams = new Map<string, string>() } = Astro.props;
const bag = (ad?: string) => teamHref(teams, ad);

const dereceSirasi = [...items].sort(
  (a, b) =>
    degreeRank(a.degree) - degreeRank(b.degree) ||
    b.year - a.year ||
    a.competition.localeCompare(b.competition, 'tr')
);
const gruplar = DERECE_GRUPLARI.map((g) => ({
  ...g,
  kayitlar: dereceSirasi.filter((a) => g.icinde(degreeRank(a.degree))),
})).filter((g) => g.kayitlar.length > 0);

const yilSirasi = [...items].sort(
  (a, b) =>
    b.year - a.year ||
    degreeRank(a.degree) - degreeRank(b.degree) ||
    a.competition.localeCompare(b.competition, 'tr')
);
const years = [...new Set(items.map((i) => i.year))].sort((a, b) => b - a);
const aramaMetni = (a: Achievement) =>
  `${a.year} ${a.competition} ${a.category} ${a.degree} ${a.team ?? ''}`.toLocaleLowerCase('tr');
---

<div class="mt-10">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Yıla göre filtrele">
      <button
        type="button"
        data-year="all"
        aria-pressed="true"
        class="year-filter rounded-lg border border-volt-400/50 bg-volt-400/10 px-3.5 py-2 font-mono text-xs tracking-wider text-volt-300 transition-colors"
      >
        TÜMÜ
      </button>
      {
        years.map((y) => (
          <button
            type="button"
            data-year={y}
            aria-pressed="false"
            class="year-filter rounded-lg border border-white/12 px-3.5 py-2 font-mono text-xs tracking-wider text-mist-300 transition-colors hover:border-white/25 hover:text-mist-100"
          >
            {y}
          </button>
        ))
      }
    </div>

    <div class="relative lg:w-72">
      <label for="ach-search" class="sr-only">Başarılarda ara</label>
      <svg
        class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-mist-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
      </svg>
      <input
        id="ach-search"
        type="search"
        placeholder="Yarışma, takım veya kategori ara…"
        class="w-full rounded-lg border border-white/12 bg-ink-900 py-2.5 pr-3 pl-9 text-sm text-mist-100 placeholder:text-mist-500 focus:border-volt-400/50 focus:outline-none"
      />
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <p id="ach-count" class="font-mono text-xs text-mist-500" aria-live="polite">
      {items.length} kayıt gösteriliyor
    </p>
    <div class="flex items-center gap-2" role="group" aria-label="Sıralama">
      <span class="font-mono text-[0.62rem] tracking-[0.15em] text-mist-500 uppercase">Sırala</span>
      <button type="button" data-view="derece" aria-pressed="true" class="view-btn rounded-lg border border-volt-400/50 bg-volt-400/10 px-3 py-1.5 font-mono text-xs text-volt-300 transition-colors">Dereceye göre</button>
      <button type="button" data-view="yil" aria-pressed="false" class="view-btn rounded-lg border border-white/12 px-3 py-1.5 font-mono text-xs text-mist-300 transition-colors hover:border-white/25 hover:text-mist-100">Yıla göre</button>
    </div>
  </div>

  <!-- Dereceye göre: gruplu görünüm -->
  <div class="ach-view mt-8 space-y-10" data-view="derece">
    {
      gruplar.map((g) => (
        <section class="ach-group" aria-labelledby={`grup-${g.id}`}>
          <h3 id={`grup-${g.id}`} class="flex items-baseline gap-3 border-b border-white/10 pb-3">
            <span class={`text-lg font-bold tracking-tight ${g.ton}`}>{g.baslik}</span>
            <span class="ach-group-count font-mono text-xs text-mist-500">{g.kayitlar.length}</span>
          </h3>
          <ul>
            {g.kayitlar.map((a) => (
              <li class="ach-row" data-year={a.year} data-search={aramaMetni(a)}>
                <div class="ach-cells">
                  <span class="font-mono text-sm text-mist-500 tabular-nums">{a.year}</span>
                  <div class="min-w-0">
                    <span class="text-sm font-semibold text-mist-100">{a.competition}</span>
                    {a.team &&
                      (bag(a.team) ? (
                        <a href={bag(a.team)} class="mt-0.5 block font-mono text-[0.7rem] text-volt-400 underline decoration-volt-400/30 underline-offset-4 hover:text-volt-300 hover:decoration-volt-400">{a.team}</a>
                      ) : (
                        <span class="mt-0.5 block font-mono text-[0.7rem] text-volt-400">{a.team}</span>
                      ))}
                  </div>
                  <span class="text-sm text-mist-300">{a.category}</span>
                  <span class={`text-sm font-semibold ${degreeTone(a.degree)}`}>{a.degree}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <!-- Yıla göre: tek liste -->
  <div class="ach-view mt-8 hidden" data-view="yil">
    <ul>
      {
        yilSirasi.map((a) => (
          <li class="ach-row" data-year={a.year} data-search={aramaMetni(a)}>
            <div class="ach-cells">
              <span class="font-mono text-sm text-mist-500 tabular-nums">{a.year}</span>
              <div class="min-w-0">
                <span class="text-sm font-semibold text-mist-100">{a.competition}</span>
                {a.team &&
                  (bag(a.team) ? (
                    <a href={bag(a.team)} class="mt-0.5 block font-mono text-[0.7rem] text-volt-400 underline decoration-volt-400/30 underline-offset-4 hover:text-volt-300 hover:decoration-volt-400">{a.team}</a>
                  ) : (
                    <span class="mt-0.5 block font-mono text-[0.7rem] text-volt-400">{a.team}</span>
                  ))}
              </div>
              <span class="text-sm text-mist-300">{a.category}</span>
              <span class={`text-sm font-semibold ${degreeTone(a.degree)}`}>{a.degree}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <p id="ach-empty" class="hidden py-10 text-center text-sm text-mist-500">
    Aramanla eşleşen kayıt bulunamadı.
  </p>
</div>

<style>
  .ach-row { border-bottom: 1px solid rgb(255 255 255 / 0.06); }
  .ach-cells { display: grid; gap: 0.25rem 1.25rem; padding: 0.9rem 0.25rem; grid-template-columns: 3.5rem 1fr; }
  .ach-cells > :nth-child(3), .ach-cells > :nth-child(4) { grid-column: 2; }
  @media (min-width: 768px) {
    .ach-cells { grid-template-columns: 4rem minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr); align-items: baseline; }
    .ach-cells > :nth-child(3), .ach-cells > :nth-child(4) { grid-column: auto; }
  }
</style>

<script>
  const views = Array.from(document.querySelectorAll<HTMLElement>('.ach-view'));
  const yearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.year-filter'));
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.view-btn'));
  const search = document.getElementById('ach-search') as HTMLInputElement | null;
  const count = document.getElementById('ach-count');
  const empty = document.getElementById('ach-empty');

  const ACTIVE = ['border-volt-400/50', 'bg-volt-400/10', 'text-volt-300'];
  const IDLE = ['border-white/12', 'text-mist-300'];

  let activeYear = 'all';
  let activeView = 'derece';

  function mark(buttons: HTMLButtonElement[], isOn: (b: HTMLButtonElement) => boolean) {
    buttons.forEach((b) => {
      const on = isOn(b);
      b.setAttribute('aria-pressed', String(on));
      b.classList.remove(...ACTIVE, ...IDLE);
      b.classList.add(...(on ? ACTIVE : IDLE));
    });
  }

  function apply() {
    const q = (search?.value ?? '').toLocaleLowerCase('tr').trim();
    let visible = 0;
    views.forEach((view) => {
      const on = view.dataset.view === activeView;
      view.classList.toggle('hidden', !on);
      view.querySelectorAll<HTMLElement>('.ach-row').forEach((row) => {
        const show =
          (activeYear === 'all' || row.dataset.year === activeYear) &&
          (!q || (row.dataset.search ?? '').includes(q));
        row.classList.toggle('hidden', !show);
        if (on && show) visible += 1;
      });
      // Boş kalan derece grubu tamamen gizlenir, sayacı görünen kayıtları gösterir.
      view.querySelectorAll<HTMLElement>('.ach-group').forEach((group) => {
        const n = group.querySelectorAll('.ach-row:not(.hidden)').length;
        group.classList.toggle('hidden', n === 0);
        const c = group.querySelector('.ach-group-count');
        if (c) c.textContent = String(n);
      });
    });
    if (count) count.textContent = `${visible} kayıt gösteriliyor`;
    empty?.classList.toggle('hidden', visible > 0);
  }

  yearButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      activeYear = btn.dataset.year ?? 'all';
      mark(yearButtons, (b) => b === btn);
      apply();
    }),
  );
  viewButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      activeView = btn.dataset.view ?? 'derece';
      mark(viewButtons, (b) => b === btn);
      apply();
    }),
  );
  search?.addEventListener('input', apply);
  apply();
</script>
