---
import { degreeTone, teamHref } from '../lib/utils';

interface Achievement {
  year: number;
  competition: string;
  category: string;
  degree: string;
  team?: string;
  featured?: boolean;
}
interface Props {
  items: Achievement[];
  /** Takım adı → dosya adı eşlemesi; verilirse takım adları sayfasına bağlanır. */
  teams?: Map<string, string>;
}
const { items, teams = new Map<string, string>() } = Astro.props;
const bag = (ad?: string) => teamHref(teams, ad);

const sorted = [...items].sort(
  (a, b) => b.year - a.year || a.competition.localeCompare(b.competition, 'tr')
);
const years = [...new Set(sorted.map((i) => i.year))].sort((a, b) => b - a);
---

<div class="mt-10">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Yıla göre filtrele">
      <button
        type="button"
        data-year="all"
        aria-pressed="true"
        class="year-filter rounded-lg border border-volt-400/50 bg-volt-400/10 px-3.5 py-2 font-mono text-xs tracking-wider text-volt-300 transition-colors"
      >
        TÜMÜ
      </button>
      {
        years.map((y) => (
          <button
            type="button"
            data-year={y}
            aria-pressed="false"
            class="year-filter rounded-lg border border-white/12 px-3.5 py-2 font-mono text-xs tracking-wider text-mist-300 transition-colors hover:border-white/25 hover:text-mist-100"
          >
            {y}
          </button>
        ))
      }
    </div>

    <div class="relative lg:w-72">
      <label for="ach-search" class="sr-only">Başarılarda ara</label>
      <svg
        class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-mist-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
      </svg>
      <input
        id="ach-search"
        type="search"
        placeholder="Yarışma, takım veya kategori ara…"
        class="w-full rounded-lg border border-white/12 bg-ink-900 py-2.5 pr-3 pl-9 text-sm text-mist-100 placeholder:text-mist-500 focus:border-volt-400/50 focus:outline-none"
      />
    </div>
  </div>

  <p id="ach-count" class="mt-4 font-mono text-xs text-mist-500" aria-live="polite">
    {sorted.length} kayıt gösteriliyor
  </p>

  <!-- Masaüstü tablo -->
  <div class="mt-4 hidden overflow-x-auto rounded-2xl border border-white/10 md:block">
    <table class="w-full min-w-[46rem] border-collapse text-left">
      <thead>
        <tr class="border-b border-white/10 bg-ink-850">
          <th scope="col" class="px-5 py-3.5 font-mono text-[0.65rem] tracking-[0.15em] text-mist-500 uppercase">Yıl</th>
          <th scope="col" class="px-5 py-3.5 font-mono text-[0.65rem] tracking-[0.15em] text-mist-500 uppercase">Yarışma</th>
          <th scope="col" class="px-5 py-3.5 font-mono text-[0.65rem] tracking-[0.15em] text-mist-500 uppercase">Kategori</th>
          <th scope="col" class="px-5 py-3.5 font-mono text-[0.65rem] tracking-[0.15em] text-mist-500 uppercase">Derece / Ödül</th>
        </tr>
      </thead>
      <tbody>
        {
          sorted.map((a) => (
            <tr
              class="ach-row border-b border-white/6 transition-colors last:border-0 hover:bg-white/3"
              data-year={a.year}
              data-search={`${a.year} ${a.competition} ${a.category} ${a.degree} ${a.team ?? ''}`.toLocaleLowerCase('tr')}
            >
              <td class="px-5 py-4 font-mono text-sm text-mist-500 tabular-nums">{a.year}</td>
              <td class="px-5 py-4">
                <span class="text-sm font-semibold text-mist-100">{a.competition}</span>
                {a.team &&
                  (bag(a.team) ? (
                    <a
                      href={bag(a.team)}
                      class="mt-0.5 block font-mono text-[0.7rem] text-volt-400 underline decoration-volt-400/30 underline-offset-4 hover:text-volt-300 hover:decoration-volt-400"
                    >
                      {a.team}
                    </a>
                  ) : (
                    <span class="mt-0.5 block font-mono text-[0.7rem] text-volt-400">{a.team}</span>
                  ))}
              </td>
              <td class="px-5 py-4 text-sm text-mist-300">{a.category}</td>
              <td class={`px-5 py-4 text-sm font-semibold ${degreeTone(a.degree)}`}>{a.degree}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <!-- Mobil kart listesi -->
  <div class="mt-4 space-y-3 md:hidden">
    {
      sorted.map((a) => (
        <article
          class="ach-row card p-4"
          data-year={a.year}
          data-search={`${a.year} ${a.competition} ${a.category} ${a.degree} ${a.team ?? ''}`.toLocaleLowerCase('tr')}
        >
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-sm font-semibold text-mist-100">{a.competition}</h3>
            <span class="shrink-0 font-mono text-xs text-mist-500">{a.year}</span>
          </div>
          <p class="mt-1 text-xs text-mist-300">{a.category}</p>
          {a.team &&
            (bag(a.team) ? (
              <a
                href={bag(a.team)}
                class="mt-1 block font-mono text-[0.7rem] text-volt-400 underline decoration-volt-400/30 underline-offset-4"
              >
                {a.team}
              </a>
            ) : (
              <p class="mt-1 font-mono text-[0.7rem] text-volt-400">{a.team}</p>
            ))}
          <p class={`mt-2.5 text-sm font-semibold ${degreeTone(a.degree)}`}>{a.degree}</p>
        </article>
      ))
    }
  </div>

  <p id="ach-empty" class="hidden py-10 text-center text-sm text-mist-500">
    Aramanla eşleşen kayıt bulunamadı.
  </p>
</div>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.ach-row'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.year-filter'));
  const search = document.getElementById('ach-search') as HTMLInputElement | null;
  const count = document.getElementById('ach-count');
  const empty = document.getElementById('ach-empty');

  const ACTIVE = ['border-volt-400/50', 'bg-volt-400/10', 'text-volt-300'];
  const IDLE = ['border-white/12', 'text-mist-300'];

  let activeYear = 'all';

  function apply() {
    const q = (search?.value ?? '').toLocaleLowerCase('tr').trim();
    let visible = 0;

    rows.forEach((row) => {
      const yearOk = activeYear === 'all' || row.dataset.year === activeYear;
      const searchOk = !q || (row.dataset.search ?? '').includes(q);
      const show = yearOk && searchOk;
      row.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });

    // Masaüstü + mobil aynı kaydı iki kez içerdiği için ikiye bölüyoruz
    const unique = Math.round(visible / 2);
    if (count) count.textContent = `${unique} kayıt gösteriliyor`;
    empty?.classList.toggle('hidden', unique > 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeYear = btn.dataset.year ?? 'all';
      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.classList.remove(...ACTIVE, ...IDLE);
        b.classList.add(...(on ? ACTIVE : IDLE));
      });
      apply();
    });
  });

  search?.addEventListener('input', apply);
  apply();
</script>
