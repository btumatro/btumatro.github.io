---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="page-intro border-b border-white/12">
  <div class="container-matro py-12 md:py-20">
    {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
    <div class="page-intro-grid mt-5">
      <h1 class="reveal">{title}</h1>
      {description && <p class="reveal page-intro-description" data-delay="70">{description}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  h1 { max-width: 20ch; font-size: clamp(2.6rem, 4.7vw, 4.8rem); line-height: 1.04; white-space: pre-line; font-weight: 600; letter-spacing: -.045em; }
  .page-intro-description { max-width: 42ch; color: var(--color-mist-300); font-size: 1rem; line-height: 1.8; }
  .page-intro-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .page-intro-grid { grid-template-columns: 1.5fr 1fr; gap: 5rem; align-items: end; } }
</style>
