---
import { url } from '../lib/utils';

interface Props {
  title: string;
  description?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { title, description, primary, secondary } = Astro.props;
---

<section class="container-matro py-8">
  <div class="card reveal relative overflow-hidden px-6 py-12 text-center md:px-12 md:py-16">
    <div class="grid-bg absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div
      class="absolute -bottom-32 left-1/2 h-72 w-[38rem] -translate-x-1/2 rounded-full bg-volt-500/15 blur-[100px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{title}</h2>
      {description && <p class="mt-4 leading-relaxed text-mist-300">{description}</p>}

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {
          primary && (
            <a
              href={url(primary.href)}
              class="rounded-xl bg-volt-400 px-6 py-3 text-sm font-semibold text-ink-950 transition-transform hover:scale-[1.03]"
            >
              {primary.label}
            </a>
          )
        }
        {
          secondary && (
            <a
              href={url(secondary.href)}
              class="rounded-xl border border-white/15 px-6 py-3 text-sm font-semibold text-mist-100 transition-colors hover:border-volt-400/50 hover:text-volt-300"
            >
              {secondary.label}
            </a>
          )
        }
      </div>

      <slot />
    </div>
  </div>
</section>
