---
import { url } from '../lib/utils';
interface Props {
  title: string;
  description?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { title, description, primary, secondary } = Astro.props;
const link = (href: string) => /^(https?:|mailto:|tel:)/i.test(href) ? href : url(href);
---
<section class="container-matro py-8">
  <div class="join-band reveal">
    <div class="join-heading"><h2>{title}</h2>{description && <p>{description}</p>}</div>
    <div class="join-actions">
      {primary && <a href={link(primary.href)} class="button-primary">{primary.label}<span aria-hidden="true">↗</span></a>}
      {secondary && <a href={link(secondary.href)} class="text-link">{secondary.label}<span aria-hidden="true">→</span></a>}
    </div>
    <div class="join-slot"><slot /></div>
  </div>
</section>
<style>
  .join-band { border-top:2px solid var(--color-volt-400); padding:3rem 0 1rem; display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center; }
  h2 { font-size:clamp(2.1rem,4vw,3.7rem); font-weight:600; line-height:1.05; max-width:20ch; }
  .join-heading p { color:var(--color-mist-300); line-height:1.75; margin-top:1.2rem; max-width:55ch; font-size:.9rem; }
  .join-actions { display:flex; align-items:center; flex-wrap:wrap; gap:1.5rem; }
  .join-slot { grid-column:1/-1; }
  .join-slot:empty { display:none; }
  @media(max-width:767px) { .join-band { grid-template-columns:1fr; } }
</style>
