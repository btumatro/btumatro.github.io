---
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
import site from '../data/site.json';
import { url, FOOTER_LINKS } from '../lib/utils';

const year = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-white/10 bg-ink-900">

  <div class="container-matro relative py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1.2fr]">
      <div>
        <Logo size={44} subtitle="" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-mist-500">
          {site.fullName} — {site.university}. {site.foundedYear} yılından bu yana
          "Milli Teknoloji Hamlesi" vizyonuyla geleceğin teknolojilerine yön veriyoruz.
        </p>

        <div class="mt-5 flex gap-2">
          {
            site.social.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.platform}
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/12 text-mist-300 transition-colors hover:border-volt-400/50 hover:text-volt-300"
              >
                <SocialIcon platform={s.platform} />
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Alt menü">
        <h2 class="font-mono text-[0.65rem] tracking-[0.2em] text-mist-500 uppercase">Site Haritası</h2>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href={url('/')} class="text-sm text-mist-300 transition-colors hover:text-volt-300">Anasayfa</a>
          </li>
          {
            FOOTER_LINKS.map((link) => (
              <li>
                <a href={url(link.href)} class="text-sm text-mist-300 transition-colors hover:text-volt-300">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-mono text-[0.65rem] tracking-[0.2em] text-mist-500 uppercase">İletişim</h2>
        <ul class="mt-4 space-y-3 text-sm text-mist-300">
          {
            site.contact.emails.map((mail) => (
              <li>
                <a href={`mailto:${mail}`} class="transition-colors hover:text-volt-300">
                  {mail}
                </a>
              </li>
            ))
          }
          <li class="leading-relaxed text-mist-500">{site.contact.address}</li>
          <li class="leading-relaxed text-mist-500">{site.contact.workshop}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-6 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="https://btu.edu.tr"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-4 transition-opacity hover:opacity-80"
      >
        <span class="font-mono text-[0.6rem] tracking-[0.18em] text-mist-500 uppercase">
          Bağlı olduğumuz<br />kurum
        </span>
        <span class="h-9 w-px bg-white/12" aria-hidden="true"></span>
        <img
          src={url('/logo-btu-beyaz.png')}
          alt="Bursa Teknik Üniversitesi"
          width="150"
          height="36"
          class="h-9 w-auto opacity-90"
          loading="lazy"
          decoding="async"
        />
      </a>

      <p class="font-mono text-xs tracking-wide text-mist-500">Milli Teknoloji Hamlesi</p>
    </div>

    <div class="mt-6 border-t border-white/10 pt-6 text-xs text-mist-500">
      <p>© {year} {site.shortName} — {site.fullName}. Tüm hakları saklıdır.</p>
    </div>
  </div>
</footer>
