---
import Logo from './Logo.astro';
import { url, NAV } from '../lib/utils';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/+$/, '');
  return current === target || current.startsWith(`${target}/`);
};
const groupActive = (item: (typeof NAV)[number]) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 bg-ink-950 border-b border-white/10 transition-[background-color,backdrop-filter,border-color] duration-300"
>
  <div class="container-matro flex h-[4.5rem] items-center justify-between gap-4">
    <a href={url('/')} class="shrink-0" aria-label="MATRO ana sayfa">
      <Logo />
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Ana menü">
      {
        NAV.map((item) =>
          item.children ? (
            <div class="nav-group relative">
              <button
                type="button"
                class:list={[
                  'nav-trigger flex items-center gap-1 rounded-lg px-3 py-2 text-[0.86rem] font-medium whitespace-nowrap transition-colors',
                  groupActive(item)
                    ? 'text-volt-300 bg-volt-400/10'
                    : 'text-mist-300 hover:bg-white/5 hover:text-mist-100',
                ]}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="nav-caret transition-transform duration-200"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>

              <div class="nav-panel invisible absolute top-full left-0 pt-2 opacity-0 transition-[opacity,transform] duration-200 -translate-y-1">
                <div class="w-72 rounded-xl border border-white/12 bg-ink-850/98 p-2 shadow-2xl shadow-black/60 backdrop-blur-xl">
                  {item.children.map((child) => (
                    <a
                      href={url(child.href)}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-lg px-3 py-2.5 transition-colors',
                        isActive(child.href) ? 'bg-volt-400/10' : 'hover:bg-white/5',
                      ]}
                    >
                      <span
                        class:list={[
                          'block text-[0.86rem] font-semibold',
                          isActive(child.href) ? 'text-volt-300' : 'text-mist-100',
                        ]}
                      >
                        {child.label}
                      </span>
                      {child.description && (
                        <span class="mt-0.5 block text-xs leading-snug text-mist-500">
                          {child.description}
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={url(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2 text-[0.86rem] font-medium whitespace-nowrap transition-colors',
                isActive(item.href)
                  ? 'text-volt-300 bg-volt-400/10'
                  : 'text-mist-300 hover:bg-white/5 hover:text-mist-100',
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="relative">
      <button
        type="button"
        data-radyo-ac
        class="radyo-dugme inline-flex h-10 items-center gap-2 rounded-lg border border-white/12 px-3 text-[0.8rem] font-semibold text-mist-100 transition-colors hover:border-volt-400/50 hover:text-volt-300"
        aria-controls="radyo"
        title="MATRO Radyo: topluluk şarkıları ve podcast"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10h16v10H4zM7 10l10-5" /><circle cx="9" cy="15" r="2" /><path d="M14 14h3M14 17h3" />
        </svg>
        <span class="hidden sm:inline">Radyo</span>
        <span class="radyo-nokta" aria-hidden="true"></span>
      </button>
      <div id="radyo-ipucu" class="radyo-ipucu" hidden role="dialog" aria-label="MATRO Radyo">
        <p class="radyo-ipucu-baslik">MATRO Radyo</p>
        <p class="radyo-ipucu-metin">Radyomuzu dinlediniz mi? Topluluk şarkılarımız ve podcastimiz burada.</p>
        <div class="radyo-ipucu-dugmeler">
          <button type="button" data-radyo-ipucu-dinle class="radyo-ipucu-dinle">Dinle</button>
          <button type="button" data-radyo-ipucu-kapat class="radyo-ipucu-kapat">Sonra</button>
        </div>
      </div>
      </div>
      <a
        href={url('/bize-katilin')}
        class="hidden rounded-sm bg-volt-400 px-4 py-2 text-[0.85rem] font-semibold text-ink-950 transition-transform hover:scale-[1.03] sm:inline-block"
      >
        Bize Katılın
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/12 text-mist-100 lg:hidden"
        aria-label="Menüyü aç"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" class="nav-open-icon"></path>
          <path d="M6 6l12 12M18 6L6 18" class="nav-close-icon hidden"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-white/10 bg-ink-950/97 backdrop-blur-xl lg:hidden">
    <nav class="container-matro flex max-h-[calc(100svh-4.5rem)] flex-col gap-1 overflow-y-auto py-4" aria-label="Mobil menü">
      {
        NAV.map((item) =>
          item.children ? (
            <div class="py-1">
              <span class="block px-3 py-2 font-mono text-[0.62rem] tracking-[0.18em] text-mist-500 uppercase">
                {item.label}
              </span>
              {item.children.map((child) => (
                <a
                  href={url(child.href)}
                  aria-current={isActive(child.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 text-[0.95rem] font-medium transition-colors',
                    isActive(child.href) ? 'bg-volt-400/10 text-volt-300' : 'text-mist-300 hover:bg-white/5',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          ) : (
            <a
              href={url(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-3 text-[0.95rem] font-medium transition-colors',
                isActive(item.href) ? 'bg-volt-400/10 text-volt-300' : 'text-mist-300 hover:bg-white/5',
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
      <a
        href={url('/bize-katilin')}
        class="mt-2 rounded-lg bg-volt-400 px-3 py-3 text-center text-[0.95rem] font-semibold text-ink-950"
      >
        Bize Katılın
      </a>
    </nav>
  </div>
</header>

<style>
  /* Açılır menü: fareyle üzerine gelince, klavyeyle odaklanınca veya tıklanınca açılır */
  .nav-group:hover .nav-panel,
  .nav-group:focus-within .nav-panel,
  .nav-group.is-open .nav-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  .nav-group:hover .nav-caret,
  .nav-group:focus-within .nav-caret,
  .nav-group.is-open .nav-caret {
    transform: rotate(180deg);
  }
  .radyo-ipucu { position: absolute; top: calc(100% + 0.7rem); right: 0; width: 16rem; padding: 0.9rem 1rem; border-radius: 0.75rem; background: var(--color-ink-900); border: 1px solid rgb(117 213 208 / 0.35); box-shadow: 0 12px 40px rgb(0 0 0 / 0.45); z-index: 70; }
  .radyo-ipucu::before { content: ''; position: absolute; top: -0.4rem; right: 1.1rem; width: 0.75rem; height: 0.75rem; background: var(--color-ink-900); border-left: 1px solid rgb(117 213 208 / 0.35); border-top: 1px solid rgb(117 213 208 / 0.35); transform: rotate(45deg); }
  .radyo-ipucu:not([hidden]) { animation: radyo-ipucu-gel 0.35s ease-out; }
  @keyframes radyo-ipucu-gel { from { opacity: 0; transform: translateY(-4px); } }
  .radyo-ipucu-baslik { font-family: var(--font-mono, monospace); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-volt-300); }
  .radyo-ipucu-metin { margin-top: 0.3rem; font-size: 0.82rem; line-height: 1.45; color: var(--color-mist-100); }
  .radyo-ipucu-dugmeler { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .radyo-ipucu-dinle { padding: 0.4rem 0.9rem; border-radius: 0.5rem; background: var(--color-volt-400); color: var(--color-ink-950); font-size: 0.8rem; font-weight: 600; cursor: pointer; }
  .radyo-ipucu-kapat { padding: 0.4rem 0.7rem; border-radius: 0.5rem; color: var(--color-mist-300); font-size: 0.8rem; cursor: pointer; }
  .radyo-ipucu-kapat:hover { color: var(--color-mist-100); }
  @media (prefers-reduced-motion: reduce) { .radyo-ipucu:not([hidden]) { animation: none; } }
  .radyo-nokta { display: none; width: 0.45rem; height: 0.45rem; border-radius: 999px; background: var(--color-ember-400); }
  :global(.radyo-caliyor) .radyo-nokta { display: inline-block; animation: radyo-nabiz 1.2s ease-in-out infinite; }
  @keyframes radyo-nabiz { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { :global(.radyo-caliyor) .radyo-nokta { animation: none; } }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');

  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 12;
    header.classList.toggle('bg-ink-950/85', scrolled);
    header.classList.toggle('backdrop-blur-xl', scrolled);

  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    if (!panel) return;
    const closed = panel.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!closed));
    toggle.setAttribute('aria-label', closed ? 'Menüyü aç' : 'Menüyü kapat');
    toggle.querySelector('.nav-open-icon')?.classList.toggle('hidden', !closed);
    toggle.querySelector('.nav-close-icon')?.classList.toggle('hidden', closed);
  });

  // Masaüstü açılır menü: tıklamayla da açılıp kapansın (dokunmatik cihazlar için)
  document.querySelectorAll<HTMLElement>('.nav-group').forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>('.nav-trigger');
    trigger?.addEventListener('click', (event) => {
      event.preventDefault();
      const open = group.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(open));
    });
  });

  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLElement>('.nav-group.is-open').forEach((group) => {
      if (group.contains(event.target as Node)) return;
      group.classList.remove('is-open');
      group.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (panel && !panel.classList.contains('hidden')) {
      panel.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Menüyü aç');
      toggle?.querySelector('.nav-open-icon')?.classList.remove('hidden');
      toggle?.querySelector('.nav-close-icon')?.classList.add('hidden');
      toggle?.focus();
    }
    document.querySelectorAll<HTMLElement>('.nav-group.is-open').forEach((group) => {
      group.classList.remove('is-open');
      group.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
